services:
  collector:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: sensor-network-collector
    restart: unless-stopped
    command: ["python", "main.py", "--config", "/app/config.json"]
    volumes:
      - ./config.json:/app/config.json
      # The web application (sensor-network-pwa) mounts this same directory to read the CSV storage.
      - ./data:/data
